# Next.js frontend — copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8001
# Server-side API URL for the /media rewrite; only needed when it differs (e.g. http://fastapi:8001 in Docker)
# API_INTERNAL_URL=

# Google AdSense — leave blank to render the placeholder slots
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
