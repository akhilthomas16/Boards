# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Encrypts secret site settings. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Database (PostgreSQL)
DATABASE_URL=postgres://boards_user:boards_pass@localhost:5432/boards_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM (OpenAI-compatible)
# Leave blank to disable AI features (endpoints return 503)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Ads
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
GOOGLE_ADSENSE_SLOT_BANNER=1234567890
GOOGLE_ADSENSE_SLOT_SIDEBAR=0987654321
GOOGLE_ADSENSE_SLOT_INFEED=1122334455

# Browser origins allowed to call the API with auth cookies (also checked on the WebSocket).
# Must be same-site with the API host: localhost:3000 → localhost:8001 works, 127.0.0.1 → localhost doesn't.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email
# Password-reset codes are emailed from here. The console backend prints them instead of sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Hash Out <noreply@localhost>
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
